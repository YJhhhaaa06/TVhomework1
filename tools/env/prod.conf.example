# ============================================================
# 生产环境配置模板（T6，本文件被 git 追踪，仅占位符无真实口令）
# ------------------------------------------------------------
# 首次使用：
#   1) 复制本文件为 prod.conf（prod.conf 已被 .gitignore 排除，不进 git）
#   2) 填入真实生产连接参数
#   3) 运行 `python tools/tv.py env prod` 激活为当前环境
# 安全约定：生产口令不得写入被 git 追踪的文件；prod.conf 本体始终保留本地。
# 优先级：环境变量 DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME > 本文件。
# ============================================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=__FILL_ME__
DB_NAME=tvdatabase

# 生产应用实例地址（仅供参考；IDEA 启动走 app.properties，与本处无关）
BASE_URL=http://127.0.0.1:8080