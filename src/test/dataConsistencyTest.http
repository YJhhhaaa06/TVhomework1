### ==================== 数据一致性验证测试 ====================
# 验证点赞/关注/评论后计数是否正确更新
# 使用前请确保：
# 1. 有两个用户（userA 和 userB）的 token
# 2. 有 userA 发布的内容（contentId 已知）
# 3. 有该内容下的评论（commentId 已知）

### ==================== 变量 ====================
# userA 的 token（发布内容的用户）
@tokenA = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI1IiwiaWF0IjoxNzc4NTg3NjY2LCJleHAiOjE3Nzg1OTQ4NjZ9.S73BNb8WkLL77KqqjwS28HuGzd7QvclP-Gf5s-PYcrY

# userB 的 token（另一个用户）
@tokenB = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI2IiwiaWF0IjoxNzc4NTg3NjY2LCJleHAiOjE3Nzg1OTQ4NjZ9.xxxxx

# 测试用内容 ID（userA 发布的内容）
@contentId = 1

# 测试用评论 ID（该内容下的评论）
@commentId = 1


### ==================== 内容点赞计数一致性 ====================

### 1. 查询点赞前的点赞数
GET http://localhost:8080/MyAPP/like/content/count?contentId={{contentId}}
token: {{tokenB}}

> {%
    client.test("记录点赞前的点赞数", function() {
        client.global.set("likeCountBefore", response.body.data);
    });
%}


### 2. userB 点赞内容
POST http://localhost:8080/MyAPP/like/content/add
token: {{tokenB}}
Content-Type: application/x-www-form-urlencoded

contentId={{contentId}}


### 3. 查询点赞后的点赞数（应该 +1）
GET http://localhost:8080/MyAPP/like/content/count?contentId={{contentId}}
token: {{tokenB}}

> {%
    client.test("点赞后计数应该 +1", function() {
        client.expect(response.body.data).to.eql(client.global.get("likeCountBefore") + 1);
    });
%}


### 4. 验证 userB 的点赞状态为 true
GET http://localhost:8080/MyAPP/like/content/status?contentId={{contentId}}
token: {{tokenB}}

> {%
    client.test("点赞状态应该为 true", function() {
        client.expect(response.body.data).to.eql(true);
    });
%}


### 5. userB 取消点赞
POST http://localhost:8080/MyAPP/like/content/remove
token: {{tokenB}}
Content-Type: application/x-www-form-urlencoded

contentId={{contentId}}


### 6. 查询取消点赞后的点赞数（应该恢复）
GET http://localhost:8080/MyAPP/like/content/count?contentId={{contentId}}
token: {{tokenB}}

> {%
    client.test("取消点赞后计数应该恢复", function() {
        client.expect(response.body.data).to.eql(client.global.get("likeCountBefore"));
    });
%}


### 7. 验证 userB 的点赞状态为 false
GET http://localhost:8080/MyAPP/like/content/status?contentId={{contentId}}
token: {{tokenB}}

> {%
    client.test("取消点赞后状态应该为 false", function() {
        client.expect(response.body.data).to.eql(false);
    });
%}


### ==================== 评论点赞计数一致性 ====================

### 8. 查询评论点赞前的点赞数
GET http://localhost:8080/MyAPP/like/comment/count?commentId={{commentId}}
token: {{tokenB}}

> {%
    client.test("记录评论点赞前的点赞数", function() {
        client.global.set("commentLikeCountBefore", response.body.data);
    });
%}


### 9. userB 点赞评论
POST http://localhost:8080/MyAPP/like/comment/add
token: {{tokenB}}
Content-Type: application/x-www-form-urlencoded

commentId={{commentId}}


### 10. 查询评论点赞后的点赞数（应该 +1）
GET http://localhost:8080/MyAPP/like/comment/count?commentId={{commentId}}
token: {{tokenB}}

> {%
    client.test("评论点赞后计数应该 +1", function() {
        client.expect(response.body.data).to.eql(client.global.get("commentLikeCountBefore") + 1);
    });
%}


### 11. userB 取消评论点赞
POST http://localhost:8080/MyAPP/like/comment/remove
token: {{tokenB}}
Content-Type: application/x-www-form-urlencoded

commentId={{commentId}}


### 12. 查询取消评论点赞后的点赞数（应该恢复）
GET http://localhost:8080/MyAPP/like/comment/count?commentId={{commentId}}
token: {{tokenB}}

> {%
    client.test("取消评论点赞后计数应该恢复", function() {
        client.expect(response.body.data).to.eql(client.global.get("commentLikeCountBefore"));
    });
%}


### ==================== 关注计数一致性 ====================

### 13. 查询 userA 关注前的粉丝数（通过 profile）
GET http://localhost:8080/MyAPP/profile?userId=5
token: {{tokenB}}

> {%
    client.test("记录 userA 关注前的粉丝数", function() {
        client.global.set("followerCountBefore", response.body.data.followerCount);
    });
%}


### 14. 查询 userB 关注前的关注数
GET http://localhost:8080/MyAPP/profile?userId=6
token: {{tokenB}}

> {%
    client.test("记录 userB 关注前的 followCount", function() {
        client.global.set("followCountBefore", response.body.data.followCount);
    });
%}


### 15. userB 关注 userA（userId=5）
POST http://localhost:8080/MyAPP/follow/add
token: {{tokenB}}
Content-Type: application/x-www-form-urlencoded

followedUserId=5


### 16. 查询 userA 关注后的粉丝数（应该 +1）
GET http://localhost:8080/MyAPP/profile?userId=5
token: {{tokenB}}

> {%
    client.test("userA 粉丝数应该 +1", function() {
        client.expect(response.body.data.followerCount).to.eql(client.global.get("followerCountBefore") + 1);
    });
%}


### 17. 查询 userB 关注后的关注数（应该 +1）
GET http://localhost:8080/MyAPP/profile?userId=6
token: {{tokenB}}

> {%
    client.test("userB 关注数应该 +1", function() {
        client.expect(response.body.data.followCount).to.eql(client.global.get("followCountBefore") + 1);
    });
%}


### 18. userB 取消关注 userA
POST http://localhost:8080/MyAPP/follow/remove
token: {{tokenB}}
Content-Type: application/x-www-form-urlencoded

followedUserId=5


### 19. 查询 userA 取消关注后的粉丝数（应该恢复）
GET http://localhost:8080/MyAPP/profile?userId=5
token: {{tokenB}}

> {%
    client.test("取消关注后 userA 粉丝数应该恢复", function() {
        client.expect(response.body.data.followerCount).to.eql(client.global.get("followerCountBefore"));
    });
%}


### 20. 查询 userB 取消关注后的关注数（应该恢复）
GET http://localhost:8080/MyAPP/profile?userId=6
token: {{tokenB}}

> {%
    client.test("取消关注后 userB 关注数应该恢复", function() {
        client.expect(response.body.data.followCount).to.eql(client.global.get("followCountBefore"));
    });
%}


### ==================== 评论计数一致性 ====================

### 21. 查询评论前的评论数
GET http://localhost:8080/MyAPP/detail?contentId={{contentId}}
token: {{tokenA}}

> {%
    client.test("记录评论前的评论数", function() {
        client.global.set("commentCountBefore", response.body.data.commentCount);
    });
%}


### 22. userA 发表评论
POST http://localhost:8080/MyAPP/comment/add
token: {{tokenA}}
Content-Type: application/json

{
    "contentId": {{contentId}},
    "message": "测试评论计数一致性"
}


### 23. 查询评论后的评论数（应该 +1）
GET http://localhost:8080/MyAPP/detail?contentId={{contentId}}
token: {{tokenA}}

> {%
    client.test("评论后评论数应该 +1", function() {
        client.expect(response.body.data.commentCount).to.eql(client.global.get("commentCountBefore") + 1);
    });
%}
