    });
%}


### ==================== 关注/取关后列表变化验证 ====================

### 15. 记录关注前的关注列表长度
GET http://localhost:8080/MyAPP/follow/following?userId={{currentUserId}}
token: {{token}}

> {%
    client.test("记录关注前的关注数", function() {
        client.global.set("followingCountBefore", response.body.data.length);
    });
%}


### 16. userB 关注 userA（userId=5）
POST http://localhost:8080/MyAPP/follow/add
token: {{token}}
Content-Type: application/x-www-form-urlencoded

followedUserId=5


### 17. 验证 userA 的粉丝列表中出现 userB
GET http://localhost:8080/MyAPP/follow/followers?userId=5
token: {{token}}

> {%
    client.test("userA 的粉丝列表中应包含 userB", function() {
        var found = response.body.data.find(item => item.userId === {{currentUserId}});
        client.expect(found).to.exist;
    });
%}


### 18. userB 取消关注 userA
POST http://localhost:8080/MyAPP/follow/remove
token: {{token}}
Content-Type: application/x-www-form-urlencoded

followedUserId=5


### 19. 验证 userA 的粉丝列表中不再有 userB
GET http://localhost:8080/MyAPP/follow/followers?userId=5
token: {{token}}

> {%
    client.test("取消关注后 userA 的粉丝列表中不应包含 userB", function() {
        var found = response.body.data.find(item => item.userId === {{currentUserId}});
        client.expect(found).to.not.exist;
    });
%}
